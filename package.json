{
  "name": "squeek",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "observer:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-observer.ps1",
    "observer:probe": "node scripts/observer-probe.ts",
    "build": "node scripts/build-desktop.mjs",
    "start": "electron .",
    "tts:start": "node server.js",
    "tts:dev": "node --watch server.js",
    "package:win": "node scripts/package-windows.ts",
    "release:audit": "node scripts/audit-package.ts",
    "release:inspect-desktop": "npm run build && node scripts/inspect-desktop.ts",
    "evaluate": "node scripts/evaluate-detection.ts",
    "test:usability": "npm run build && node tests/electron-usability.mjs",
    "test:desktop": "npm run build && node tests/electron-smoke.mjs",
    "test:chrome": "node tests/chrome-extraction.mjs",
    "desktop:setup": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "express": "^5.2.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/desktop/main.mjs"
}
