# Local development only. Packaged Squeek does not load or ship this credential.
TYPESAFE_API_KEY=
# Streamed warning voice in the desktop app (falls back to a local Windows voice).
ELEVENLABS_API_KEY=
# Voice conversations with the ghost (hold Ctrl to talk). OPEN_API is also accepted.
OPENAI_API_KEY=
# Optional model overrides.
# OPENAI_CHAT_MODEL=gpt-5.4-mini
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Links this PC to the iPhone's account (sign in with the same email on both). Public values: the
# project URL and its anon key. Development builds only.
SQUEEK_SUPABASE_URL=
SQUEEK_SUPABASE_ANON_KEY=
