// Shared build settings for the app and all extensions.
// Put your own values in Config/Secrets.xcconfig (git-ignored); copy Secrets.example.xcconfig to start.

// Your Apple Developer Team ID (Xcode › Settings › Accounts). Required to sign extensions.
CLICKEY_TEAM_ID =

// "Free" (Personal Team) or "Paid" (Apple Developer Program). Paid adds push notifications,
// Sign in with Apple and the protective-DNS setting, which free teams can't sign.
CLICKEY_ACCOUNT = Free

// Bundle ids must be unique across all developers, so change the prefix to something you own.
CLICKEY_BUNDLE_ID = dev.squeek.clickey
CLICKEY_APP_GROUP = group.$(CLICKEY_BUNDLE_ID)

// Supabase project host only (xcconfig treats "//" as a comment, so no https://).
SUPABASE_HOST = your-project.supabase.co
SUPABASE_ANON_KEY =

#include? "Secrets.xcconfig"
