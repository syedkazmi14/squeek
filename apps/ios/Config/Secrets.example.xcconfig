// Copy to Config/Secrets.xcconfig and fill in. That file is git-ignored.
// The anon key is designed to be public (row-level security protects the data),
// but keep it out of git anyway so projects can be swapped easily.

CLICKEY_TEAM_ID = ABCDE12345
CLICKEY_BUNDLE_ID = com.yourname.clickey
SUPABASE_HOST = abcdefghijklmnop.supabase.co
SUPABASE_ANON_KEY = eyJhbGciOi...
